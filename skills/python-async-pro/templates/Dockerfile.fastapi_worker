# Production Celery Worker for FastAPI
# Minimal, secure, multi-stage build

FROM python:3.11-slim as builder

WORKDIR /build
COPY requirements.txt .
RUN pip install --user --no-cache-dir -r requirements.txt

# Final stage
FROM python:3.11-slim

# Security: non-root user
RUN useradd -m -u 1000 worker

WORKDIR /app
COPY --from=builder /root/.local /home/worker/.local
COPY . .

ENV PATH=/home/worker/.local/bin:$PATH
ENV PYTHONUNBUFFERED=1

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD celery -A app.tasks inspect ping

RUN chown -R worker:worker /app
USER worker

# Multi-queue worker with graceful shutdown
CMD ["sh", "-c", "\
    exec celery \
    -A app.tasks worker \
    -Q default,high,email,reports \
    --concurrency=4 \
    --loglevel=info \
    --max-tasks-per-child=1000 \
    --time-limit=1800 \
    --soft-time-limit=1500 \
    --without-gossip \
    --without-mingle \
    --without-heartbeat \
    "]
